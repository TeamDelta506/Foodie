# Foodie — environment configuration
#
# Copy this file to .env and fill in your values.
#   cp .env.example .env   (Mac/Linux)
#   copy .env.example .env  (Windows)
#
# .env is gitignored — never commit real keys.

# Flask session signing (required). Generate with:
#   python -c import secrets; print(secrets.token_hex(32))
SECRET_KEY=generate-a-random-32-byte-hex-string

# Database URL (default matches docker-compose db service)
DATABASE_URL=postgresql://app:app@db:5432/app

# GitHub OAuth — create at https://github.com/settings/applications/new
# Callback URL must be: http://localhost:5000/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Edamam Recipe Search API (optional for recipe search features)
EDAMAM_APP_ID=your-application-id
EDAMAM_APP_KEY=your-application-key

# Playwright / CI test backdoor — enable /test-login and /api/debug routes.
# Set to 1 in dev/CI only. NEVER set in a public-facing production deployment.
# ENABLE_TEST_LOGIN=1
