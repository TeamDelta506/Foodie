FROM python:3.12-slim

WORKDIR /app

# Install dependencies first; Docker caches this layer if requirements don't change.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the app.
COPY . .

# Render sets PORT at runtime; local docker-compose.prod overrides via GUNICORN_BIND.
ENV PORT=10000
EXPOSE 10000

# Production: Gunicorn (bind from gunicorn.conf.py — TCP on Render, unix socket behind nginx).
CMD ["gunicorn", "-c", "gunicorn.conf.py", "app:app"]

